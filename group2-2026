<h1>আমার ডিউটি রোস্টার ২০২৬ (Group-2)</h1>

<div class="today-banner" id="todayBanner"></div>

<div class="filters">
  <button class="filter-btn btn-all" onclick="filterShifts('all')">সব দেখুন</button>
  <button class="filter-btn btn-Mor" onclick="filterShifts('Mor')">Morning</button>
  <button class="filter-btn btn-Eve" onclick="filterShifts('Eve')">Evening</button>
  <button class="filter-btn btn-Night" onclick="filterShifts('Night')">Night</button>
  <button class="filter-btn btn-off" onclick="filterShifts('off')">Off Days</button>
  <button class="filter-btn btn-spr" onclick="filterShifts('spr')">Spare</button>
  <button class="filter-btn btn-ccl" onclick="filterShifts('ccl')">Holidays (CCL)</button>
</div>

<div class="calendar-container" id="calendar"></div>

<script>
  // --- Data Setup (Same as before) ---
  
  // ২৮ দিনের সাইকেল
  const cycle = [
    'Mor', 'Mor', 'Mor', 
    'Eve', 'Eve', 
    'Night', 'Night', 
    'off', 'off',
    'spr', 
    'Mor', 'Mor', 
    'Eve', 'Eve', 
    'Night', 'Night', 'Night', 
    'off', 'off',
    'Mor', 'Mor', 
    'Eve', 'Eve', 'Eve', 
    'Night', 'Night', 
    'off', 'off'
  ];

  // ছুটির দিনগুলোর লিস্ট
  const holidays = [
    {m: 0, d: 23}, // 23 Jan
    {m: 0, d: 26}, // 26 Jan
    {m: 2, d: 3},  // 3 March
    {m: 2, d: 21}, // 21 March
    {m: 3, d: 3},  // 3 April
    {m: 4, d: 1},  // 1 May
    {m: 5, d: 26}, // 26 June
    {m: 7, d: 15}, // 15 August
    {m: 9, d: 2},  // 2 October
    {m: 9, d: 20}, // 20 October
    {m: 9, d: 21}, // 21 October
    {m: 10, d: 8}, // 8 November
    {m: 10, d: 24},// 24 November
    {m: 11, d: 25} // 25 December
  ];

  const year = 2026;
  const refDate = new Date(year, 0, 3); // ৩রা জানুয়ারি 

  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  const container = document.getElementById('calendar');
  
  // আজকের তারিখ (টেস্ট করার জন্য চাইলে ডেট পরিবর্তন করা যেতে পারে)
  const today = new Date(); 
  let todayShift = null;

  // --- Calendar Generation ---
  for (let month = 0; month < 12; month++) {
    const monthDiv = document.createElement('div');
    monthDiv.className = 'month';
    monthDiv.innerHTML = `<h2>${months[month]}</h2>`;

    const grid = document.createElement('div');
    grid.className = 'days-grid';

    // Day Headers
    days.forEach(day => {
      const div = document.createElement('div');
      div.className = 'day-header';
      div.textContent = day;
      grid.appendChild(div);
    });

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Empty initial days
    for (let i = 0; i < firstDay; i++) {
      const empty = document.createElement('div');
      empty.className = 'day empty';
      grid.appendChild(empty);
    }

    // Creating actual days
    for (let date = 1; date <= daysInMonth; date++) {
      const currentDate = new Date(year, month, date);
      
      // ক্যালকুলেট শিফট
      const diffTime = currentDate.getTime() - refDate.getTime();
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
      let cycleIndex = diffDays % 28;
      if (cycleIndex < 0) { cycleIndex += 28; }
      const shift = cycle[cycleIndex];
      
      // চেক হলিডে
      const isHoliday = holidays.some(h => h.m === month && h.d === date);

      // Create day element
      const dayDiv = document.createElement('div');
      dayDiv.className = 'day';
      dayDiv.setAttribute('data-shift', shift);
      
      if (isHoliday) {
        dayDiv.classList.add('holiday-ccl');
        dayDiv.setAttribute('data-holiday', 'true');
      }

      // হাইলাইট টুডে (শুধুমাত্র ২০২৬ সালে কাজ করবে)
      if (today.getFullYear() === year && today.getMonth() === month && today.getDate() === date) {
        dayDiv.classList.add('today-highlight');
        todayShift = shift;
      }

      // Populate day content
      let innerContent = `<span class="date">${date}</span>`;
      if (isHoliday) {
        innerContent += `<span class="ccl-tag">CCL</span>`;
      }
      innerContent += `<span class="shift shift-${shift}">${shift}</span>`;
      
      dayDiv.innerHTML = innerContent;
      grid.appendChild(dayDiv);
    }

    monthDiv.appendChild(grid);
    container.appendChild(monthDiv);
  }

  // --- Today's Banner Setup ---
  const banner = document.getElementById('todayBanner');
  if (today.getFullYear() === year && todayShift) {
    let shiftText = todayShift;
    if (shiftText === 'Mor') shiftText = 'Morning Duty';
    if (shiftText === 'Eve') shiftText = 'Evening Duty';
    if (shiftText === 'Night') shiftText = 'Night Duty';
    if (shiftText === 'off') shiftText = 'Off Day (ছুটি)!';
    if (shiftText === 'spr') shiftText = 'Spare Duty';
    
    // বাংলায় তারিখ
    const banglaMonths = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];
    
    banner.innerHTML = `
      <span class="date-text">আজ <strong>${today.getDate()} ${banglaMonths[today.getMonth()]}</strong>. আপনার আজকের ডিউটি:</span><br>
      <span class="shift-text shift-${todayShift}">${shiftText}</span>
    `;
  } else {
    banner.innerHTML = "এটি অর্পণ-এর ২০২৬ সালের ডিউটি ক্যালেন্ডার। বর্তমানে অন্য সাল চলছে, তাই আজকের ডিউটি দেখানো যাচ্ছে না।";
  }

  // --- Filter Function ---
  function filterShifts(selectedShift) {
    const allDays = document.querySelectorAll('.day[data-shift]');
    allDays.forEach(day => {
      // সবার আগে পুরোনো Dimmed স্টেট সরিয়ে ফেলুন
      day.classList.remove('dimmed');
      
      if (selectedShift === 'all') {
        // কিছু করতে হবে না, সবার থেকে পুরোনো Dimmed সরিয়ে দেওয়া হয়েছে
      } else if (selectedShift === 'ccl') {
        // যদি সি-সি-এল ফিল্টার সিলেক্ট করা থাকে এবং এটি হলিডে না হয়, তবে ডিম করুন
        if (day.getAttribute('data-holiday') !== 'true') {
          day.classList.add('dimmed');
        }
      } else {
        // যদি সিলেক্টেড শিফট এই দিনের শিফটের সাথে না মেলে, তবে ডিম করুন
        if (day.getAttribute('data-shift') !== selectedShift) {
          day.classList.add('dimmed');
        }
      }
    });
  }
</script>

</body>
